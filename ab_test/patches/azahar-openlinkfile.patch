-    LOG_WARNING(Service_FS, "(STUBBED) File command OpenLinkFile {}", GetName());
+    // Duplicate the current handle (3dbrew / libctru FSFILE_OpenLinkFile).
+    // Snapshot the source session *before* ClientConnected so a vector grow
