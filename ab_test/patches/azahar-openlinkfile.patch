+    const FileSessionSlot* original_file = GetSessionData(ctx.Session());
+    const u32 priority = original_file->priority;
+    const u64 offset = original_file->offset;
+    const u64 size = original_file->size;
+    const bool subfile = original_file->subfile;
+    LOG_WARNING(Service_FS,
+                "OpenLinkFile {} clone offset={:#x} size={:#x} subfile={} backend={:#x}",
+                GetName(), offset, size, subfile, backend->GetSize());
+
     using Kernel::ClientSession;
     using Kernel::ServerSession;
     IPC::RequestParser rp(ctx);
@@ -388,12 +409,10 @@ void File::OpenLinkFile(Kernel::HLERequestContext& ctx) {
     ClientConnected(server);
 
     FileSessionSlot* slot = GetSessionData(std::move(server));
-    const FileSessionSlot* original_file = GetSessionData(ctx.Session());
-
-    slot->priority = original_file->priority;
-    slot->offset = 0;
-    slot->size = backend->GetSize();
-    slot->subfile = false;
+    slot->priority = priority;
+    slot->offset = offset;
+    slot->size = size;
+    slot->subfile = subfile;
 
     rb.Push(ResultSuccess);
     rb.PushMoveObjects(client);
@@ -410,11 +429,14 @@ void File::OpenSubFile(Kernel::HLERequestContext& ctx) {
 
     if (original_file->subfile) {
         // OpenSubFile can not be called on a file which is already as subfile
+        LOG_WARNING(Service_FS, "OpenSubFile {} already a subfile", GetName());
         rb.Push(FileSys::ResultUnsupportedOpenFlags);
         return;
     }
 
     if (offset < 0 || size < 0) {
+        LOG_WARNING(Service_FS, "OpenSubFile {} negative offset={} size={}", GetName(), offset,
+                    size);
         rb.Push(FileSys::ResultWriteBeyondEnd);
