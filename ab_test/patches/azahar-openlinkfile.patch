     }
@@ -424,6 +446,9 @@ void File::OpenSubFile(Kernel::HLERequestContext& ctx) {
     // TODO(Subv): Check for overflow and return ResultWriteBeyondEnd
 
     if (end > original_file->size) {
+        LOG_WARNING(Service_FS,
+                    "OpenSubFile {} beyond end offset={} size={} session={:#x}", GetName(), offset,
+                    size, original_file->size);
         rb.Push(FileSys::ResultWriteBeyondEnd);
         return;
     }
