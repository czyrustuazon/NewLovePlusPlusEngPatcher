#!/bin/sh
# Run the CI checks before a push. Locally this also runs the vanilla-backed
# code.bin checks (tests/test_code_patch_map.py) that CI has to skip.
# Install: python dev/install_hooks.py   Bypass once: git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

PY=python
command -v "$PY" >/dev/null 2>&1 || PY=python3

# The CI steps on a clean clone of HEAD: no game dumps or untracked files,
# so coverage matches GitHub (pip install -r dev/requirements-dev.txt).
echo "[pre-push] CI checks (dev/ci_local.py)"
"$PY" dev/ci_local.py || {
    echo "[pre-push] CI checks failed; push aborted"
    exit 1
}

echo "[pre-push] pytest (local data: vanilla game dumps, Azahar fork)"
"$PY" -m pytest tests/ -q -x -rs -p no:cacheprovider -m local_data || {
    echo "[pre-push] tests failed; push aborted"
    exit 1
}
