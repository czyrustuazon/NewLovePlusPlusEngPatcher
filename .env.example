# Local, machine-specific config. Copy to `.env` (gitignored) and fill in.
# Nothing here ships in the repo.

# --- src/report_progress.py : report script-text % to the companion site ---
# Auto-POSTs after `patch_textresource.py rebuild`, Drop CIA.bat, and nlpp-gold CI.
# Ask the site maintainer for the endpoint + a bearer token. Prefer a
# progress-only PROGRESS_API_TOKEN on the Worker (ADMIN_API_TOKEN also works
# as a fallback but also authorizes /api/admin/devlog).
# Without these, the reporter still prints the counts (--dry-run / --best-effort)
# but will not POST. Set NLPP_PROGRESS_SKIP=1 to disable auto-report entirely.
NLPP_PROGRESS_ENDPOINT=https://example.invalid/api/admin/progress
NLPP_PROGRESS_TOKEN=

# --- src/patch_textresource.py translate : optional OpenAI MT ---
# OPENAI_API_KEY=
